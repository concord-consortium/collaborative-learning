# Local storage for Firebase Emulator Suite
emulator-data/*
!emulator-data/.gitkeep

# Compiled JavaScript files
lib/**/*.js
lib/**/*.js.map
# resolveJsonModule copies an imported .json file's source into lib/ too, at the same relative path
lib/**/*.json

# TypeScript v1 declaration files
typings/

# Node.js dependency directory
node_modules/
*.local
