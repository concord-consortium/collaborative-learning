# Copy to `.env.local` (gitignored) for local emulator runs.
#
# `.env.local` is the file Firebase reserves for emulation and never deploys. A plain `.env` IS
# read at deploy time and applied to the deployed functions of whichever project is selected — for
# the model params below that would mean a local value deciding which model production calls. Use
# `.env.local`.
#
# This file is for non-secret configuration. API keys go in `.secret.local` instead.

# Skips verifying the caller's Firebase ID token, so the emulator can be used with a real GitHub
# token without emulating the GitHub auth flow. DO NOT set this outside the emulator.
DANGEROUSLY_SKIP_AUTH_TOKEN_VALIDATION=true

# --- Unit summary generation (POST /generateUnitSummary) ---
#
# Both are defineStrings with no default: leave one unset and the generation route sends
# `model: ""`, OpenAI 400s, and generation fails with a clean error rather than silently picking a
# model. Two separate params (rather than one) so the digest step (one call per problem, run many
# times) can move to a cheaper model without touching the prior-knowledge/overview step, with no
# code change either way.
UNIT_SUMMARY_DIGEST_MODEL=gpt-5.5
UNIT_SUMMARY_MODEL=gpt-5.5
